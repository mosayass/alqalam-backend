# AlQalam Development Environment Variables
# Copy to .env for local Docker Compose overrides if needed.
# Real .env files are excluded from source control.

POSTGRES_USER=alqalam_dev
POSTGRES_PASSWORD=alqalam_dev_password
POSTGRES_DB=alqalam
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# JWT Authentication (Host API requirement)
# SigningKey must be at least 32 characters long
Jwt__Issuer=AlQalam
Jwt__Audience=AlQalam.Clients
Jwt__SigningKey=your_dev_secret_key_at_least_32_characters_long!
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30
